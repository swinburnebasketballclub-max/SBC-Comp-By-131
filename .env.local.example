# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored — never commit it, never paste keys into chat.
# Find these in Supabase → Project Settings → API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Full access to the database, bypasses row level security.
# Never prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site (used to build player invite links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
